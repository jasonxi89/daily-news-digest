# OpenRouter API
OPENROUTER_API_KEY=sk-or-v1-xxx
OPENROUTER_MODEL=deepseek/deepseek-v4-pro

# Gmail SMTP (use App Password, not account password)
GMAIL_ADDRESS=your-email@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
RECIPIENT_EMAIL=recipient@example.com

# Timezone
TZ=Asia/Shanghai

# 失败告警 webhook（可选，留空禁用）
# 兼容 Server酱等常见 webhook：POST JSON {"title", "body", "desp"}
ALERT_WEBHOOK_URL=

# 双窗口机制（可选）
# STATE_FILE: 上次成功发送时间的状态文件路径（需挂载 volume 持久化）
# DEFAULT_WINDOW_HOURS: 无状态文件时的抓取窗口（小时）；有状态时窗口自动
#   按 now - 上次成功时间 计算，下限 1h、封顶 48h
STATE_FILE=/app/data/last_success.json
DEFAULT_WINDOW_HOURS=24
